{
  "name": "screego-launcher",
  "productName": "Screego Launcher",
  "version": "0.1.0",
  "description": "A desktop launcher for the Screego screen-sharing server (LAN mode).",
  "type": "module",
  "main": "dist/main/index.js",
  "author": "kerolt",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "pack:core": "node scripts/pack-core.mjs",
    "dist": "npm run pack:core && npm run build && electron-builder --mac"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^45.0.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^2.3.0",
    "lucide-react": "^1.61.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.0",
    "vite": "^5.4.21"
  },
  "build": {
    "appId": "dev.kerolt.screego-launcher",
    "asar": true,
    "files": [
      "dist/**",
      "assets/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets/cores",
        "to": "assets/cores"
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dir"
      ]
    }
  }
}
